# 后端 code 对应的文案（后端只回 code，文案在此翻译）
msgid "nlbw command not found, nlbwmon may not be installed."
msgstr "未找到 nlbw 命令，nlbwmon 可能未安装。"

msgid "nlbwmon has no database directory configured."
msgstr "nlbwmon 未配置数据库目录。"

msgid "Database directory is on tmpfs ({dir}), history will be lost after reboot."
msgstr "数据库目录位于 tmpfs（{dir}），重启后历史数据会丢失。"

msgid "nf_conntrack_acct is disabled, counters may be missing or low."
msgstr "未开启 nf_conntrack_acct，流量计数可能缺失或偏低。"

msgid "A fullcone NAT module was detected, conntrack events may not reach nlbwmon."
msgstr "检测到 fullcone NAT 模块，conntrack 事件可能无法送达 nlbwmon。"

msgid "nlbwmon may have stopped counting because its netlink receive buffer is too small ({conntrack} connections). The repair raises the buffer and restarts nlbwmon."
msgstr "nlbwmon 可能因接收缓冲不足已停止计数（当前 {conntrack} 条连接）。修复会调大缓冲并重启 nlbwmon。"

msgid "Repair collector"
msgstr "修复采集器"

msgid "Repairing…"
msgstr "正在修复…"

msgid "Repair failed. Check the system log for details."
msgstr "修复失败，请检查系统日志。"

msgid "The collector was restarted; data may take a few tens of seconds to come back."
msgstr "采集器已重启，数据可能需要几十秒才能恢复。"

msgid "fullcone and nlbwmon are mutually exclusive on this firmware: once the module is loaded, statistics stay at zero. The fix turns off fullcone NAT (affects NAT type for P2P and online games) and disables the kernel module. It only changes files and never reboots the router; a manual reboot is required."
msgstr "fullcone 与 nlbwmon 在本固件上互斥：模块一旦加载，统计会一直是 0。修复会关闭 fullcone NAT（影响 P2P / 游戏联机的 NAT 类型）并禁用该内核模块。操作只改文件、不会自动重启，需要你手动重启路由器才生效。"

msgid "fullcone is disabled; conntrack events resume after the router reboots."
msgstr "fullcone 已禁用，重启路由器后 conntrack 事件才会恢复。"

msgid "Reboot the router manually (System → Reboot); statistics resume after that. Counters before the reboot are not recovered."
msgstr "请手动重启路由器（系统 → 重启）后恢复统计；重启前的计数不会补回。"

msgid "Original files are backed up in {dir}; run restore.sh there to undo the change."
msgstr "原始文件已备份到 {dir}，可运行其中的 restore.sh 回退（需手动重启）。"

msgid "Fix automatically"
msgstr "一键修复"

msgid "Fixing…"
msgstr "正在修复…"

msgid "Fix failed. Check the system log for details."
msgstr "修复失败，请检查系统日志。"

msgid "Backup failed; nothing was changed. Check free space and try again."
msgstr "备份失败，未做任何修改。请检查存储空间后重试。"

msgid "Confirmation is required to apply the fix."
msgstr "需要确认后才能执行修复。"

msgid "fullcone support is built into this firmware kernel and cannot be disabled automatically."
msgstr "该固件的 fullcone 已编译进内核，无法自动禁用，请改用不含 fullcone 的固件。"

msgid "nlbwmon has no local_network configured, no traffic will be counted."
msgstr "nlbwmon 未配置 local_network，可能统计不到任何网段。"

msgid "Database directory must not be empty."
msgstr "数据库目录不能为空。"

msgid "Database directory must not be on tmpfs (/tmp, /var) or the root directory, otherwise history is lost after reboot."
msgstr "数据库目录不能位于 tmpfs（/tmp、/var）或根目录，否则重启后会丢失历史。"

msgid "Retention must be between 90 and 3650 days."
msgstr "保留天数需在 90 至 3650 天之间。"

msgid "Auto refresh must be one of 0 / 10 / 30 / 60."
msgstr "自动刷新间隔只能是 0 / 10 / 30 / 60 秒。"

msgid "Commit interval must look like 6h or 30m."
msgstr "落盘间隔格式应形如 6h 或 30m。"

msgid "Failed to write configuration: {detail}"
msgstr "写入配置失败：{detail}"

msgid "confirm=true is required to clear the database."
msgstr "需要 confirm=true 才能清空数据库。"

msgid "Database directory is not configured or not usable, aborted."
msgstr "数据库目录未配置或不可用，已中止。"

msgid "Invalid MAC address."
msgstr "MAC 地址无效。"
