#!/usr/bin/env ucode
// SPDX-License-Identifier: Apache-2.0
//
// luci.wrtbwstat —— FlowLens 后端 ubus 对象
//
// 目标固件：OpenWrt 25.12+（rpcd-mod-ucode + ucode 环境）
// 依据：doc/OpenWrt流量统计插件设计文档_v2.md 第 4.4、5.1 节
//
// 设计要点：
//   1. 只通过 `nlbw -c json` 读取数据，不解析 nlbwmon 数据库文件格式。
//   2. 账期按自然日切分：今日读守护进程活跃库（不带 -t），历史日读归档库（-t）。
//   3. nlbw 单次调用只能读一个账期，多日窗口需逐日聚合，
//      因此对"今天以外的账期"做只读缓存（历史账期归档后不再变化）。
//   4. 设备维度以 MAC 归并，同 MAC 的多个 IPv4/IPv6 地址自然合并。
'use strict';

import { popen, readfile, writefile, mkdir, unlink, stat, access, glob, rename } from 'fs';
import { cursor } from 'uci';

// nlbw 的实际安装路径随 OpenWrt 版本/打包而异：24.10 在 /usr/sbin，部分分支在 /usr/bin。
// 启动时按候选列表探测一次，避免写死单一路径导致"nlbw 缺失"的假告警。
const NLBW_CANDIDATES = [ '/usr/sbin/nlbw', '/usr/bin/nlbw', '/sbin/nlbw' ];
let nlbw_path = null;

function nlbw_bin() {
	if (nlbw_path != null)
		return nlbw_path;

	for (let p in NLBW_CANDIDATES)
		if (access(p)) return (nlbw_path = p);

	nlbw_path = '';
	return '';
}
const CACHE_DIR = '/tmp/wrtbwstat-cache';
const UNKNOWN_MAC = '00:00:00:00:00:00';
// 名称解析失败时返回空字符串，由前端本地化为「未知设备」/「Unknown device」
const UNKNOWN_NAME = '';

const RANGES = { today: 1, yesterday: 1, last7: 7, last30: 30, last90: 90 };
const SORTS = [ 'total', 'rx', 'tx', 'hostname', 'mac' ];
const REFRESH_CHOICES = [ 0, 10, 30, 60 ];

const DEFAULT_RETENTION_DAYS = 95;
const DEFAULT_REFRESH_INTERVAL = 30;

/*
 * 存储布局：settings.storage_dir 只是父目录，nlbwmon 的库落在它的 wrtbwstat/
 * 子目录里。这样目录里只有自己写的库文件，清空时按目录整体处理也不会碰到
 * 用户的其他数据（storage_dir 可以放心指向 /mnt/usb 这类盘根）。
 */
const DATA_SUBDIR = 'wrtbwstat';
const DEFAULT_STORAGE_DIR = '/mnt/usb';

function data_dir_of(base) {
	base = trim(base ?? '');

	while (length(base) > 1 && substr(base, length(base) - 1) == '/')
		base = substr(base, 0, length(base) - 1);

	return ((length(base) > 1) ? base : '') + '/' + DATA_SUBDIR;
}

// 递归建目录：ucode 的 mkdir() 只建一级，<base>/a/b 这种路径会因父目录缺失失败
function mkdir_p(path) {
	if (!path || path == '/' || access(path))
		return;

	let slash = rindex(path, '/');

	if (slash > 0)
		mkdir_p(substr(path, 0, slash));

	mkdir(path);
}

// 容量保护：以 mock 实测的稳定上限为 100% —— 90 天 × 200 台/天 = 18000 设备日。
// 设备日（每天出现的设备数逐日累加）才是聚合与渲染成本的真实放大因子，
// 累计年限和累计字节数都不是。使用率超过 80% 时裁剪最旧的历史归档，留 20% 余量。
const CAPACITY_DEVICE_DAYS = 18000;
const CAPACITY_TRIGGER = 0.8;
const CAPACITY_MIN_DAYS = 7;

// ---------------------------------------------------------------------------
// 通用工具
// ---------------------------------------------------------------------------

function num(v) {
	if (v == null) return 0;
	let n = +v;
	return (n == n) ? n : 0;   // 过滤 NaN
}

/**
 * 字符串比较，返回 -1 / 0 / 1。
 * ucode 的 sort() 比较器必须返回数值：返回布尔时比较被视为"相等"，数组不会发生任何交换。
 */
function cmp_str(a, b) {
	if (a < b) return -1;
	if (a > b) return 1;
	return 0;
}

/** 成员判断。注意不能写成 list[value]，那是按"值当下标"取，数组里存的是值不是下标 */
function in_list(list, value) {
	for (let item in list)
		if (item == value) return true;
	return false;
}

/**
 * 按空白拆分并去掉空字段。
 * ucode 的 split(str) 省略分隔符时返回 null（不是按空白拆分），必须显式给分隔符。
 */
function split_ws(s) {
	let out = [];
	let flat = replace(type(s) == 'string' ? s : '', '\t', ' ');

	for (let part in split(trim(flat), ' ')) {
		let p = trim(part);
		if (length(p) > 0) push(out, p);
	}

	return out;
}

/** 执行命令并收集 stdout；失败时 rc != 0 */
function run(cmd) {
	try {
		let fd = popen(cmd, 'r');
		if (!fd) return { rc: -1, out: '', error: 'popen failed' };
		let out = fd.read('all') ?? '';
		let rc = fd.close();
		return { rc: (rc == null) ? 0 : rc, out, error: null };
	}
	catch (e) {
		return { rc: -1, out: '', error: '' + e };
	}
}

function shq(s) {
	return "'" + replace('' + s, "'", "'\\''") + "'";
}

// 换目录时把旧库文件搬进新目录；不覆盖同名文件，返回搬移个数。
// 必须定义在 run() 之后：ucode 的函数声明不是提升的，前面的函数引用 run 会报
// "access to undeclared variable run"。
function move_db_files(from, to) {
	if (type(from) != 'string' || length(from) < 2 || from == to)
		return 0;

	mkdir_p(to);

	let moved = 0;

	for (let pattern in [ from + '/*.db', from + '/*.db.gz', from + '/nlbwmon.db*' ]) {
		for (let file in glob(pattern)) {
			let st = stat(file);

			if (st?.type != 'file')
				continue;

			let slash = rindex(file, '/');
			let dst = to + '/' + (slash >= 0 ? substr(file, slash + 1) : file);

			if (access(dst))
				continue;

			try {
				if (rename(file, dst)) {
					moved++;
					continue;
				}
			}
			catch (e) {}

			// rename 不能跨文件系统（闪存 -> U 盘），回退到 mv
			if (run(sprintf('mv %s %s', shq(file), shq(dst))).rc == 0 && access(dst))
				moved++;
		}
	}

	return moved;
}

function is_digits(s) {
	if (length(s) == 0) return false;
	for (let i = 0; i < length(s); i++) {
		let c = substr(s, i, 1);
		if (c < '0' || c > '9') return false;
	}
	return true;
}

function is_day(s) {
	if (type(s) != 'string' || length(s) != 10) return false;
	if (substr(s, 4, 1) != '-' || substr(s, 7, 1) != '-') return false;
	return is_digits(substr(s, 0, 4)) && is_digits(substr(s, 5, 2)) && is_digits(substr(s, 8, 2));
}

function is_mac(s) {
	if (type(s) != 'string' || length(s) != 17) return false;
	for (let i in [ 2, 5, 8, 11, 14 ])
		if (substr(s, i, 1) != ':') return false;
	for (let i in [ 0, 1, 3, 4, 6, 7, 9, 10, 12, 13, 15, 16 ]) {
		let c = lc(substr(s, i, 1));
		if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
	}
	return true;
}

function normalize_mac(m) {
	let s = lc(trim(m ?? ''));
	return is_mac(s) ? s : null;
}

/**
 * 热路径专用的 MAC 归一化。
 *
 * nlbw 和缓存文件里的 MAC 已经是标准格式，走 is_mac 的逐字符校验每行要 74µs，
 * 90 天 × 200 台设备就是 1.3 秒。这里只校验长度和 5 个分隔符，
 * 不可信来源（手填配置、请求参数）仍然走 is_mac。
 */
function normalize_mac_fast(m) {
	if (type(m) != 'string' || length(m) != 17)
		return null;

	let s = lc(m);

	if (substr(s, 2, 1) != ':' || substr(s, 5, 1) != ':' || substr(s, 8, 1) != ':' ||
	    substr(s, 11, 1) != ':' || substr(s, 14, 1) != ':')
		return null;

	return s;
}

/** 判断路径是否落在 tmpfs（重启即失）——用于拒绝把数据库目录设在内存文件系统 */
function is_tmpfs_path(p) {
	if (type(p) != 'string' || length(p) == 0)
		return false;

	let s = (substr(p, length(p) - 1, 1) == '/') ? substr(p, 0, length(p) - 1) : p;

	return (s == '/tmp' || s == '/var' || substr(s, 0, 5) == '/tmp/' || substr(s, 0, 5) == '/var/');
}

// ---------------------------------------------------------------------------
// 时间窗与自然日枚举（以路由器本地时区为准）
// ---------------------------------------------------------------------------

function fmt_day(d) {
	return sprintf('%04d-%02d-%02d', d.year, d.mon, d.mday);
}

function today() {
	return fmt_day(localtime());
}

/**
 * 今天本地时间 00:00 的时间戳。
 *
 * 只取一次，之后按 86400 秒推日期：timelocal() 每次都要做完整的字段归一化，
 * 90 天窗口连续算 90 次要 20ms 左右，占热请求耗时的四分之一。
 */
function day_anchor() {
	let l = localtime();
	return time() - l.hour * 3600 - l.min * 60 - l.sec;
}

/**
 * 相对今天偏移 offset 天的日期字符串。
 *
 * 以「中午 12:00」为锚点做加减：夏令时切换当天 ±1 小时仍在同一天内，
 * 不会因为 00:00 跨到前一天/后一天。
 */
function day_at(offset) {
	let ts = day_anchor() - offset * 86400 + 12 * 3600;
	return fmt_day(localtime(ts));
}

/** 由旧到新返回 count 个自然日，末位为今天 */
function day_list(count) {
	let out = [];
	let noon = day_anchor() + 12 * 3600;

	for (let i = count - 1; i >= 0; i--) {
		let d = fmt_day(localtime(noon - i * 86400));
		if (d) push(out, d);
	}

	return out;
}

function range_days(range) {
	return RANGES[range] ?? 1;
}

/**
 * 时间窗对应的自然日列表。
 *
 * yesterday 是单日窗口，不能走 day_list(1) —— 后者返回的是「以今天为末位的 1 天」，
 * 也就是今天。其余窗口都以今天为末位向前取 N 天。
 */
function days_for_range(range) {
	if (range == 'yesterday') {
		let d = day_at(1);
		return d ? [ d ] : [];
	}

	return day_list(range_days(range));
}

function normalize_range(range) {
	return (type(range) == 'string' && RANGES[range] != null) ? range : 'today';
}

function normalize_sort(sort) {
	return (type(sort) == 'string' && in_list(SORTS, sort)) ? sort : 'total';
}

// ---------------------------------------------------------------------------
// nlbw 查询与缓存
// ---------------------------------------------------------------------------

function cache_file(day, group) {
	return sprintf('%s/%s-%s.json', CACHE_DIR, replace(day, '-', ''), replace(group, ',', '_'));
}

function cache_read(day, group) {
	if (day == today()) return null;              // 今天的账期仍在增长，不缓存

	let file = cache_file(day, group);
	if (!access(file)) return null;

	let raw = readfile(file);
	if (!raw) return null;

	try {
		let rows = json(raw);
		return (type(rows) == 'array') ? rows : null;
	}
	catch (e) {
		return null;
	}
}

function cache_write(day, group, rows) {
	if (day == today()) return;

	try {
		mkdir(CACHE_DIR);
		writefile(cache_file(day, group), sprintf('%J', rows));
	}
	catch (e) {
		// 缓存失败不影响主流程
	}
}

function cache_clear() {
	for (let file in glob(CACHE_DIR + '/*')) {
		try { unlink(file); } catch (e) {}
	}
}

/**
 * 失败账期的负缓存 TTL（秒）。
 *
 * 归档后的历史日期不再变化：如果查不到数据（路由关机、nlbwmon 未运行、归档缺失），
 * 说明这天就是没有流量。不记住失败的话，每次轮询都会为这些空日期重跑一次 nlbw ——
 * 新装环境近 90 天里可能缺 89 天，单次请求要多花 0.7 秒。
 *
 * 不设成永久：磁盘异常、归档被重新生成等情况下，最多等一个 TTL 就能恢复。
 */
const MISS_TTL = 300;

function cache_miss_file(day, group) {
	return sprintf('%s/%s-%s.miss', CACHE_DIR, day, replace(group, ',', '_'));
}

function cache_miss_valid(day, group) {
	let st = stat(cache_miss_file(day, group));
	return st != null && (time() - st.mtime) < MISS_TTL;
}

function cache_miss_mark(day, group) {
	try {
		mkdir(CACHE_DIR);
		writefile(cache_miss_file(day, group), sprintf('%d\n', time()));
	}
	catch (e) {}
}

/**
 * 查询某个账期的 nlbw 数据。
 *
 * @param day     YYYY-MM-DD
 * @param group   nlbw 的 -g 参数，如 'mac' 或 'mac,layer7'
 * @returns { rows, error }
 *
 * `nlbw -c json` 输出 { "columns": [...], "data": [[...], ...] }，
 * 列集合随 -g 变化，因此按列名映射而不是按固定下标取值。
 */
function nlbw_query(day, group) {
	if (!is_day(day))
		return { rows: [], error: 'invalid date: ' + day };

	let cached = cache_read(day, group);
	if (cached != null)
		return { rows: cached, error: null, cached: true };

	// 历史账期刚刚查过且失败：不再重复执行 nlbw，但仍按"失败"上报。
	// 不能返回"无数据"：get_device 依赖 error 判断 layer7 分组不可用并回退到 proto，
	// 若把失败伪装成空结果，热缓存下历史账期会全部变成 0。
	if (day != today() && cache_miss_valid(day, group))
		return { rows: [], error: 'nlbw query failed (cached)', cached: true };

	let bin = nlbw_bin();
	if (!bin)
		return { rows: [], error: 'nlbw not found (nlbwmon missing?)' };

	let cmd = sprintf('%s -c json -n -g %s -o -rx_bytes', bin, group);

	// 今天读守护进程的活跃数据库；历史日期读归档库
	if (day != today())
		cmd += ' -t ' + day;

	cmd += ' 2>/dev/null';

	let res = run(cmd);
	if (res.rc != 0 || length(res.out) == 0) {
		// 今天的数据库随时在变，失败不能记住；历史日期记住一个 TTL
		if (day != today())
			cache_miss_mark(day, group);

		return { rows: [], error: res.error ?? ('nlbw exited with ' + res.rc) };
	}

	let parsed;
	try {
		parsed = json(res.out);
	}
	catch (e) {
		return { rows: [], error: 'failed to parse nlbw json: ' + e };
	}

	let columns = (type(parsed?.columns) == 'array') ? parsed.columns : [];
	let data = (type(parsed?.data) == 'array') ? parsed.data : [];
	let rows = [];

	for (let rec in data) {
		if (type(rec) != 'array') continue;

		let obj = {};
		for (let i = 0; i < length(columns); i++)
			obj[columns[i]] = rec[i];

		push(rows, obj);
	}

	cache_write(day, group, rows);

	return { rows, error: null };
}

// ---------------------------------------------------------------------------
// 设备名解析：自定义别名 -> DHCP 租约 -> MAC
// ---------------------------------------------------------------------------

function alias_map() {
	let map = {};

	try {
		let ctx = cursor();
		ctx.load('wrtbwstat');
		ctx.foreach('wrtbwstat', 'alias', function(section) {
			let mac = normalize_mac(section.mac);
			if (mac && section.name && length(section.name) > 0)
				map[mac] = section.name;
		});
	}
	catch (e) {}

	return map;
}

function lease_info() {
	let map = {};
	let raw = readfile('/tmp/dhcp.leases') ?? '';

	// 每行格式：expiry mac ip hostname clientid，hostname 为 * 表示客户端未上报
	for (let line in split(trim(raw), '\n')) {
		let f = split_ws(line);
		if (length(f) >= 4) {
			let mac = normalize_mac(f[1]);
			if (!mac)
				continue;

			map[mac] = {
				name: (f[3] != '*' && length(f[3]) > 0) ? f[3] : null,
				ip: (length(f[2]) > 0) ? f[2] : null
			};
		}
	}

	return map;
}

/** ARP 表：补充没有 DHCP 租约（静态地址）设备的 IP */
function arp_map() {
	let map = {};

	for (let line in split(trim(readfile('/proc/net/arp') ?? ''), '\n')) {
		let f = split_ws(line);
		if (length(f) < 4 || f[0] == 'IP')
			continue;

		let mac = normalize_mac(f[3]);
		if (mac && mac != UNKNOWN_MAC)
			map[mac] = f[0];
	}

	return map;
}

/**
 * 每次请求只读一遍别名 / 租约 / ARP：
 *   name(mac) 真实主机名或别名，取不到时返回空串（由前端决定显示成 MAC 还是"未知设备"）
 *   ip(mac)   租约优先，其次 ARP，都没有返回 null
 */
function device_directory() {
	let aliases = alias_map();
	let leases = lease_info();
	let arp = arp_map();

	return {
		name: function(mac) {
			if (!mac) return UNKNOWN_NAME;
			return aliases[mac] ?? leases[mac]?.name ?? '';
		},
		ip: function(mac) {
			if (!mac) return null;
			return leases[mac]?.ip ?? arp[mac] ?? null;
		}
	};
}

// ---------------------------------------------------------------------------
// 聚合
// ---------------------------------------------------------------------------

/** 单日按 MAC 汇总：{ mac: { rx_bytes, tx_bytes, conns } } */
function day_by_mac(day) {
	let out = {};
	let q = nlbw_query(day, 'mac');

	for (let r in q.rows) {
		let mac = normalize_mac_fast(r.mac);
		if (!mac) continue;

		let e = out[mac];
		if (!e)
			e = out[mac] = { rx_bytes: 0, tx_bytes: 0, conns: 0 };

		e.rx_bytes += num(r.rx_bytes);
		e.tx_bytes += num(r.tx_bytes);
		e.conns += num(r.conns);
	}

	return out;
}

/**
 * 把单日 { mac: { rx_bytes, tx_bytes, conns } } 累加进时间窗聚合。
 *
 * @returns 该日的 { rx_bytes, tx_bytes } 合计
 */
function merge_day(devs, per) {
	let rx = 0, tx = 0;

	for (let mac in per) {
		let p = per[mac];
		rx += p.rx_bytes;
		tx += p.tx_bytes;

		let e = devs[mac];
		if (!e)
			e = devs[mac] = { mac: mac, rx_bytes: 0, tx_bytes: 0, conns: 0, days_active: 0 };

		e.rx_bytes += p.rx_bytes;
		e.tx_bytes += p.tx_bytes;
		e.conns += p.conns;
		e.days_active++;
	}

	return { rx_bytes: rx, tx_bytes: tx };
}

/** 聚合结果转成返回给前端的设备数组（share 以窗口总量为分母） */
function devices_from_data(data) {
	let out = [];

	for (let mac in data.devs) {
		let e = data.devs[mac];
		let sum = e.rx_bytes + e.tx_bytes;

		push(out, {
			mac: e.mac,
			rx_bytes: e.rx_bytes,
			tx_bytes: e.tx_bytes,
			total_bytes: sum,
			conns: e.conns,
			days_active: e.days_active,
			// 注意：ucode 的 int/int 是整除，必须显式转 double，否则 share 恒为 0
			share: (data.total > 0) ? ((sum * 1.0) / data.total) : 0,
			first_seen: null,
			last_seen: null
		});
	}

	return out;
}

// ---------------------------------------------------------------------------
// 时间窗 rollup 缓存
//
// 两天天以前的历史账期已经不会再变，把它们按时间窗聚合一次落盘：
// 之后每次请求只读一个文件，再实时补上昨天与今天。
// 200 台设备/天的规模下，90 天窗口从"每次解析 1.8 万行"降到约 50ms。
// ---------------------------------------------------------------------------

/** 只冻结 2 天以前的日期：昨天可能尚未归档（跨日竞态），今天仍在增长 */
const ROLLUP_END_OFFSET = 2;

function rollup_file(range) {
	return sprintf('%s/rollup-%s-mac.json', CACHE_DIR, range);
}

/** 时间窗内可冻结的历史日期（不含昨天与今天），按日期升序 */
function frozen_days(range) {
	let days = days_for_range(range);
	let cutoff = day_at(1);
	let out = [];

	for (let day in days) {
		// YYYY-MM-DD 可直接按字典序比较
		if (day < cutoff)
			push(out, day);
	}

	return out;
}

/** 读取 rollup；结束日期不是"前天"说明跨天了，需要重建 */
function rollup_read(range) {
	let raw = readfile(rollup_file(range));
	if (!raw) return null;

	try {
		let o = json(raw);

		if (type(o) != 'object' || o.end != day_at(ROLLUP_END_OFFSET))
			return null;

		if (type(o.days) != 'array' || type(o.devs) != 'array')
			return null;

		return o;
	}
	catch (e) {
		return null;
	}
}

function rollup_build(range) {
	let days = frozen_days(range);
	let devs = {};
	let dayTotals = [];
	let total = 0;

	for (let day in days) {
		let t = merge_day(devs, day_by_mac(day));
		total += t.rx_bytes + t.tx_bytes;
		push(dayTotals, [ day, t.rx_bytes, t.tx_bytes ]);
	}

	let list = [];

	for (let mac in devs) {
		let e = devs[mac];
		push(list, [ e.mac, e.rx_bytes, e.tx_bytes, e.conns, e.days_active ]);
	}

	let payload = {
		end: day_at(ROLLUP_END_OFFSET),
		days: dayTotals,
		devs: list,
		total
	};

	try {
		mkdir(CACHE_DIR);
		writefile(rollup_file(range), sprintf('%J', payload));
	}
	catch (e) {
		// 落盘失败不影响本次结果，下次请求重建
	}

	return payload;
}

/**
 * 取一个时间窗的完整聚合。
 *
 * ctx 是本次请求内的单日缓存（day -> { mac: ... }），
 * get_summary 要算 5 个窗口，共享它可避免重复查询今天/昨天。
 */
function range_data(range, ctx) {
	ctx = ctx ?? {};

	let days = days_for_range(range);
	let devs = {};
	let total = 0;
	let dayTotals = {};
	let roll = null;

	if (length(frozen_days(range)) > 0) {
		roll = rollup_read(range);
		if (roll == null)
			roll = rollup_build(range);

		for (let d in roll.days) {
			dayTotals[d[0]] = { rx_bytes: d[1], tx_bytes: d[2] };
			total += d[1] + d[2];
		}

		for (let d in roll.devs)
			devs[d[0]] = { mac: d[0], rx_bytes: d[1], tx_bytes: d[2], conns: d[3], days_active: d[4] };
	}

	// rollup 之外的日期（昨天、今天）实时聚合
	for (let day in days) {
		if (roll != null && day <= roll.end)
			continue;

		let per = ctx[day];
		if (per == null)
			per = ctx[day] = day_by_mac(day);

		let t = merge_day(devs, per);
		dayTotals[day] = t;
		total += t.rx_bytes + t.tx_bytes;
	}

	return { days, devs, total, dayTotals };
}

function sort_devices(list, sortBy) {
	let key = (sortBy == 'rx') ? 'rx_bytes'
	        : (sortBy == 'tx') ? 'tx_bytes'
	        : 'total_bytes';

	sort(list, function(a, b) {
		// 按名称排序时，来源不明的设备（MAC 解析失败）统一排到最后
		if (sortBy == 'hostname') {
			let ua = a.unknown_source ? 1 : 0;
			let ub = b.unknown_source ? 1 : 0;

			if (ua != ub)
				return ua - ub;

			return cmp_str(lc(a.hostname || a.mac), lc(b.hostname || b.mac));
		}
		if (sortBy == 'mac') return cmp_str(a.mac, b.mac);
		return b[key] - a[key];    // 数值降序：比较器必须返回数值而非布尔
	});

	return list;
}

// ---------------------------------------------------------------------------
// 系统状态
// ---------------------------------------------------------------------------

function uci_get(config, section, option) {
	try {
		return cursor().get(config, section, option);
	}
	catch (e) {
		return null;
	}
}

/*
 * fullcone NAT 与 nlbwmon 在同一台设备上互斥：
 *   - fw4 启动时用 `nft -c` 无条件探测 fullcone 表达式（与 UCI 里 fullcone 是 0 还是 1 无关），
 *     解析表达式本身会触发 request_module，把 nft_fullcone 拉进内核；
 *   - 模块一旦加载，ctnetlink 的 conntrack 事件就不再投递，nlbwmon 恒为 0；
 *   - rmmod 之后事件不会恢复，必须重启，重启后 fw4 又会探测加载。
 * 因此唯一有效的处置是让探测失败：关掉功能开关，并让 .ko 在文件系统里消失（改名）。
 */

function fullcone_files() {
	let active = [], disabled = [];

	for (let f in glob('/lib/modules/*/nft_fullcone.ko*')) {
		if (substr(f, length(f) - 9) == '.disabled')
			push(disabled, f);
		else
			push(active, f);
	}

	return { active, disabled };
}

function fullcone_state() {
	let files = fullcone_files();

	return {
		loaded: length(glob('/sys/module/*fullcone*')) > 0,
		modules_d: access('/etc/modules.d/nft-fullcone'),
		active: files.active,
		disabled: files.disabled
	};
}

/*
 * 修复前先把要改的文件原样备份，用户随时可以跑 restore.sh 回退。
 * 备份落在插件独占目录里，不覆盖上一份：多次执行各留一份，最近一次的路径
 * 记在 fullcone-backup，供页面在"待重启"状态下展示。
 */
const BACKUP_ROOT = '/etc/wrtbwstat/backup';
const BACKUP_MARKER = '/etc/wrtbwstat/fullcone-backup';

function backup_stamp() {
	let l = localtime();
	return sprintf('%04d%02d%02d-%02d%02d%02d', l.year, l.mon, l.mday, l.hour, l.min, l.sec);
}

function copy_file(src, dst) {
	if (run(sprintf('cp -a %s %s', shq(src), shq(dst))).rc != 0 || !access(dst))
		return false;
	return true;
}

/** 最近一次修复的备份目录；未备份或已被删除时返回 null */
function fullcone_backup_dir() {
	let d = trim(readfile(BACKUP_MARKER) ?? '');
	return (length(d) > 1 && access(d)) ? d : null;
}

/** 落盘改名；已改过返回 skipped，失败返回 failed（squashfs 只读、空间不足等） */
function disable_file(path) {
	let dst = path + '.disabled';

	if (access(dst))
		return 'skipped';

	try {
		if (rename(path, dst))
			return 'renamed';
	}
	catch (e) {}

	// overlayfs 上的 rename 理论上走写时复制，保险起见保留 mv 回退
	if (run(sprintf('mv %s %s', shq(path), shq(dst))).rc == 0 && access(dst))
		return 'renamed';

	return 'failed';
}

function collector_info() {
	let networks = uci_get('nlbwmon', '@nlbwmon[0]', 'local_network');

	if (type(networks) == 'string')
		networks = split_ws(networks);
	else if (type(networks) != 'array')
		networks = [];

	return {
		directory: uci_get('nlbwmon', '@nlbwmon[0]', 'database_directory'),
		interval: uci_get('nlbwmon', '@nlbwmon[0]', 'database_interval'),
		generations: +(uci_get('nlbwmon', '@nlbwmon[0]', 'database_generations') ?? 0),
		commit_interval: uci_get('nlbwmon', '@nlbwmon[0]', 'commit_interval'),
		compress: (uci_get('nlbwmon', '@nlbwmon[0]', 'database_compress') ?? '0') == '1',
		local_networks: networks,
		binary_present: !!nlbw_bin(),
		binary_path: nlbw_bin()
	};
}

// ---------------------------------------------------------------------------
// 容量保护
//
// 100% = 实测边界（90 天 × 200 台/天 = 18000 设备日）。
// 使用率 = 90 天窗口内所有设备的 days_active 之和 / 18000。
// 超过 80% 时删除最旧的历史归档，把窗口内的数据量压回阈值以内；
// 同时让插件自己的单日缓存与 rollup 同步失效，否则被删的数据还会从缓存里读出来。
// ---------------------------------------------------------------------------

function capacity_status_file() {
	return CACHE_DIR + '/capacity.json';
}

function capacity_stats(data, withData) {
	let deviceDays = 0;
	let count = 0;

	for (let mac in data.devs) {
		deviceDays += data.devs[mac].days_active;
		count++;
	}

	return {
		limit_device_days: CAPACITY_DEVICE_DAYS,
		trigger: CAPACITY_TRIGGER,
		device_days: deviceDays,
		device_count: count,
		days_with_data: withData,
		percent: (deviceDays * 1.0) / CAPACITY_DEVICE_DAYS,
		keep_days: null,
		cleaned_archives: 0,
		cleaned_cache_files: 0,
		updated: time()
	};
}

function capacity_read() {
	try {
		let o = json(readfile(capacity_status_file()) ?? '');
		return (type(o) == 'object') ? o : null;
	}
	catch (e) {
		return null;
	}
}

function capacity_write(stats) {
	try {
		mkdir(CACHE_DIR);
		writefile(capacity_status_file(), sprintf('%J', stats));
	}
	catch (e) {
		// 状态文件只用于设置页展示，写失败不影响主流程
	}
}

/** 缓存文件名里取出 YYYYMMDD；rollup/状态文件返回 null */
function cache_file_day(name) {
	if (length(name) >= 8 && is_digits(substr(name, 0, 8)))
		return substr(name, 0, 8);

	if (length(name) >= 10 && is_day(substr(name, 0, 10)))
		return replace(substr(name, 0, 10), '-', '');

	return null;
}

/**
 * 超阈值时裁剪最旧的历史（就地修改 stats 并返回）。
 *
 * 只动 nlbwmon 的归档（nlbwmon.db.<N>[.gz]，N 越大越旧），不碰当前库；
 * 保留 keep 天的历史，宁可多留一天也不越过用户配置的窗口。
 */
function capacity_cleanup(stats) {
	if (stats.device_days <= CAPACITY_TRIGGER * CAPACITY_DEVICE_DAYS)
		return stats;

	let activeDays = (stats.days_with_data > 0) ? stats.days_with_data : 1;
	let avg = stats.device_days / activeDays;
	let keep = int((CAPACITY_TRIGGER * CAPACITY_DEVICE_DAYS) / avg);

	if (keep < CAPACITY_MIN_DAYS) keep = CAPACITY_MIN_DAYS;
	if (keep > 90) keep = 90;

	stats.keep_days = keep;

	let dir = collector_info().directory;
	if (type(dir) != 'string' || length(dir) < 2)
		return stats;

	let base = dir + '/';
	let files = [];

	// nlbwmon 的历史库按账期命名：YYYYMMDD.db / YYYYMMDD.db.gz（当前库是 nlbwmon.db）
	for (let f in glob(base + '*.db*')) {
		let name = substr(f, length(base));
		let stamp = substr(name, 0, 8);

		if (length(name) < 11 || !is_digits(stamp))
			continue;

		let rest = substr(name, 8);
		if (rest != '.db' && rest != '.db.gz')
			continue;

		push(files, [ stamp, f ]);
	}

	// 旧 -> 新；保留最新的 keep-1 个归档（今天的数据在当前库里，共 keep 天）
	sort(files, function(a, b) { return cmp_str(a[0], b[0]); });

	let keepArchives = (keep > 0) ? keep - 1 : 0;

	for (let i = 0; i < length(files) - keepArchives; i++) {
		try {
			if (unlink(files[i][1]))
				stats.cleaned_archives++;
		}
		catch (e) {}
	}

	// 被裁掉的日期不能继续从插件的单日缓存 / rollup 里读出来
	let cutoff = replace(day_at(keep - 1), '-', '');
	let cacheBase = CACHE_DIR + '/';

	for (let f in glob(cacheBase + '*')) {
		let name = substr(f, length(cacheBase));
		let day = cache_file_day(name);

		if ((day != null && day < cutoff) || substr(name, 0, 7) == 'rollup-') {
			try {
				if (unlink(f))
					stats.cleaned_cache_files++;
			}
			catch (e) {}
		}
	}

	return stats;
}

/** 采集链路风险提示，供页面顶部告警条消费 */
function collect_warnings() {
	let warnings = [];
	let info = collector_info();

	// 告警以 code + 参数返回，具体文案由前端按当前语言渲染
	if (!info.binary_present)
		push(warnings, { code: 'warnNlbwMissing' });

	if (!info.directory)
		push(warnings, { code: 'warnNoDirectory' });
	else if (is_tmpfs_path(info.directory))
		push(warnings, { code: 'warnTmpfs', dir: info.directory });

	let acct = trim(readfile('/proc/sys/net/netfilter/nf_conntrack_acct') ?? '');
	if (acct != '1')
		push(warnings, { code: 'warnAcctOff' });

	// 模块已禁用但还没重启时，事件仍然是断的——文案要区分"去修复"和"去重启"
	let fc = fullcone_state();

	if (fc.loaded) {
		let repaired = (length(fc.active) == 0 && length(fc.disabled) > 0);
		let warning = { code: repaired ? 'warnFullconeReboot' : 'warnFullcone' };

		// 已修复的话把备份位置一并带出去，用户重启前还能看到怎么回退
		if (repaired) {
			let dir = fullcone_backup_dir();
			if (dir) warning.dir = dir;
		}

		push(warnings, warning);
	}

	if (length(info.local_networks) == 0)
		push(warnings, { code: 'warnNoLocalNet' });

	return warnings;
}

function read_settings() {
	let storage_dir = uci_get('wrtbwstat', 'settings', 'storage_dir') ?? DEFAULT_STORAGE_DIR;

	return {
		storage_dir,
		data_dir: data_dir_of(storage_dir),
		retention_days: +(uci_get('wrtbwstat', 'settings', 'retention_days') ?? DEFAULT_RETENTION_DAYS),
		commit_interval: uci_get('wrtbwstat', 'settings', 'commit_interval') ?? '6h',
		compress: (uci_get('wrtbwstat', 'settings', 'compress') ?? '1') == '1',
		refresh_interval: +(uci_get('wrtbwstat', 'settings', 'refresh_interval') ?? DEFAULT_REFRESH_INTERVAL)
	};
}

// ---------------------------------------------------------------------------
// rpcd 方法
// ---------------------------------------------------------------------------

const methods = {};

methods.get_summary = {
	args: { range: '' },
	call: function(request) {
		let range = normalize_range(request.args?.range);

		// 五个时间窗共用同一份 90 天数据：历史部分来自 rollup，昨天/今天实时算一次
		let ctx = {};
		let data = range_data('last90', ctx);
		let days = data.days;
		let withData = 0;

		for (let day in days) {
			let t = data.dayTotals[day];
			if (t && (t.rx_bytes > 0 || t.tx_bytes > 0)) withData++;
		}

		let ranges = [];

		for (let name in [ 'today', 'yesterday', 'last7', 'last30', 'last90' ]) {
			let span = RANGES[name];
			let series = [];
			let rx = 0, tx = 0;

			if (name == 'yesterday') {
				let y = day_at(1);
				let t = (y && data.dayTotals[y]) ? data.dayTotals[y] : { rx_bytes: 0, tx_bytes: 0 };
				rx = t.rx_bytes;
				tx = t.tx_bytes;
				if (y) push(series, { date: y, rx_bytes: rx, tx_bytes: tx });
			}
			else {
				for (let i = length(days) - span; i < length(days); i++) {
					let d = days[i];
					let t = data.dayTotals[d] ?? { rx_bytes: 0, tx_bytes: 0 };
					rx += t.rx_bytes;
					tx += t.tx_bytes;
					push(series, { date: d, rx_bytes: t.rx_bytes, tx_bytes: t.tx_bytes });
				}
			}

			push(ranges, {
				range: name,
				days: span,
				rx_bytes: rx,
				tx_bytes: tx,
				total_bytes: rx + tx,
				series
			});
		}

		// 容量保护：先算当前负载，超阈值就裁掉最旧的历史，并把结果留给设置页展示
		let prev = capacity_read();
		let capacity = capacity_cleanup(capacity_stats(data, withData));

		capacity.last_cleanup = (capacity.cleaned_archives > 0)
			? { at: time(), cleaned: capacity.cleaned_archives, keep_days: capacity.keep_days }
			: (prev?.last_cleanup ?? null);

		capacity_write(capacity);

		return {
			range,
			updated: time(),
			timezone: trim(readfile('/etc/TZ') ?? ''),
			days_with_data: withData,
			ranges,
			capacity,
			warnings: collect_warnings(),
			errors: nlbw_bin() ? [] : [ 'nlbw 不可用，全部数据为空。' ]
		};
	}
};

methods.get_devices = {
	args: { range: '', sort: '', keyword: '' },
	call: function(request) {
		let range = normalize_range(request.args?.range);
		let sortBy = normalize_sort(request.args?.sort);
		let keyword = trim(request.args?.keyword ?? '');
		let data = range_data(range);
		let days = data.days;
		let result = {
			devices: devices_from_data(data),
			total_bytes: data.total
		};
		let dir = device_directory();

		let devices = [];
		let kw = lc(keyword);

		for (let d in result.devices) {
			d.unknown_source = (d.mac == UNKNOWN_MAC);
			d.hostname = d.unknown_source ? '' : dir.name(d.mac);
			d.ip = d.unknown_source ? null : dir.ip(d.mac);

			// 关键词匹配名称、MAC 与 IP，方便直接按 IP 找设备
			if (length(kw) > 0 &&
			    index(lc((d.hostname ?? '') + ' ' + d.mac + ' ' + (d.ip ?? '')), kw) < 0)
				continue;

			push(devices, d);
		}

		sort_devices(devices, sortBy);

		return {
			range,
			sort: sortBy,
			keyword,
			days,
			total_bytes: result.total_bytes,
			device_count: length(devices),
			devices
		};
	}
};

methods.get_device = {
	args: { mac: '', range: '' },
	call: function(request) {
		let mac = normalize_mac(request.args?.mac);
		let range = normalize_range(request.args?.range);

		if (!mac)
			return { mac: null, hostname: null, range, error: { code: 'errInvalidMac' }, days: [], protocols: [] };

		let days = days_for_range(range);
		let series = [];
		let protos = {};
		let protoField = null;
		let errors = [];

		for (let day in days) {
			// 优先按 layer7（协议名）分组；某些版本不允许按复合字段分组，
			// 此时退回按协议号分组，前端会显示 "proto 6" 这类标签。
			let q = nlbw_query(day, 'mac,layer7');

			if (q.error) {
				q = nlbw_query(day, 'mac,proto');
				if (q.error) {
					push(errors, day + ': ' + q.error);
					continue;
				}
			}

			let rx = 0, tx = 0;

			for (let r in q.rows) {
				if (normalize_mac_fast(r.mac) != mac) continue;

				rx += num(r.rx_bytes);
				tx += num(r.tx_bytes);

				let name;
				if (r.layer7 != null) {
					name = r.layer7;
					protoField = protoField ?? 'layer7';
				}
				else if (r.proto != null) {
					// 实测：nlbw 的 layer7 多数为 null（协议库只映射少量端口），
					// 此时退回协议名；分组里带了端口就带上端口，信息量更大。
					let port = num(r.port);
					// 字符串协议名（IP/TCP/UDP）直接用；数字协议号保留 proto N 的形式，
					// 否则界面上只剩一个 "6" 无法辨认
					let pname = (type(r.proto) == 'string') ? r.proto : sprintf('proto %s', r.proto);
					name = (port > 0) ? sprintf('%s/%d', pname, port) : pname;
					protoField = protoField ?? 'proto';
				}
				else {
					name = 'other';
					protoField = protoField ?? 'proto';
				}

				let p = protos[name];
				if (!p) p = protos[name] = { name, rx_bytes: 0, tx_bytes: 0 };
				p.rx_bytes += num(r.rx_bytes);
				p.tx_bytes += num(r.tx_bytes);
			}

			push(series, { date: day, rx_bytes: rx, tx_bytes: tx });
		}

		let protoList = [];
		let ptotal = 0;

		for (let name in protos) {
			let p = protos[name];
			p.total_bytes = p.rx_bytes + p.tx_bytes;
			if (p.total_bytes <= 0)
				continue;    // 跳过只有零字节连接的协议，避免占位条目
			ptotal += p.total_bytes;
			push(protoList, p);
		}

		for (let p in protoList)
			p.share = (ptotal > 0) ? ((p.total_bytes * 1.0) / ptotal) : 0;

		sort(protoList, function(a, b) { return b.total_bytes - a.total_bytes; });

		return {
			mac,
			hostname: (mac == UNKNOWN_MAC) ? '' : device_directory().name(mac),
			range,
			proto_field: protoField,
			days: series,
			protocols: protoList,
			errors
		};
	}
};

methods.get_settings = {
	args: {},
	call: function() {
		let settings = read_settings();
		let info = collector_info();

		// 容量状态由 get_summary 周期写入；还没跑过汇总时给出阈值与空指标
		let capacity = capacity_read() ?? {
			limit_device_days: CAPACITY_DEVICE_DAYS,
			trigger: CAPACITY_TRIGGER,
			device_days: null,
			device_count: null,
			days_with_data: null,
			percent: null,
			keep_days: null,
			cleaned_archives: 0,
			cleaned_cache_files: 0,
			updated: null,
			last_cleanup: null
		};

		return {
			storage_dir: settings.storage_dir,
			data_dir: settings.data_dir,
			retention_days: settings.retention_days,
			commit_interval: settings.commit_interval,
			compress: settings.compress,
			refresh_interval: settings.refresh_interval,
			collector: info,
			capacity,
			cache_dir: CACHE_DIR,
			warnings: collect_warnings()
		};
	}
};

methods.set_settings = {
	args: { storage_dir: '', retention_days: 0, commit_interval: '', compress: false, refresh_interval: 0 },
	call: function(request) {
		let args = request.args ?? {};
		let errors = [];
		let changed = [];

		if (args.storage_dir != null) {
			if (type(args.storage_dir) != 'string' || length(trim(args.storage_dir)) < 2) {
				push(errors, 'errDirEmpty');
			}
			else {
				let dir = trim(args.storage_dir);

				if (dir == '/' || is_tmpfs_path(dir))
					push(errors, 'errDirTmpfs');
				else
					push(changed, [ 'storage_dir', dir ]);
			}
		}

		if (args.retention_days != null) {
			let n = +args.retention_days;

			if (!(n >= 90 && n <= 3650))
				push(errors, 'errRetention');
			else
				push(changed, [ 'retention_days', sprintf('%d', n) ]);
		}

		if (args.refresh_interval != null) {
			let n = +args.refresh_interval;

			if (!in_list(REFRESH_CHOICES, n))
				push(errors, 'errRefresh');
			else
				push(changed, [ 'refresh_interval', sprintf('%d', n) ]);
		}

		if (args.commit_interval != null) {
			let s = (type(args.commit_interval) == 'string') ? trim(args.commit_interval) : '';

			if (length(s) < 2) {
				push(errors, 'errCommit');
			}
			else {
				let unit = substr(s, length(s) - 1, 1);
				let digits = substr(s, 0, length(s) - 1);

				if (!is_digits(digits) || index('smhd', unit) < 0)
					push(errors, 'errCommit');
				else
					push(changed, [ 'commit_interval', s ]);
			}
		}

		if (args.compress != null)
			push(changed, [ 'compress', args.compress ? '1' : '0' ]);

		if (length(errors) > 0)
			return { success: false, errors };

		let names = [];
		for (let kv in changed) push(names, kv[0]);

		try {
			let ctx = cursor();
			ctx.load('wrtbwstat');

			// 配置文件被手工删改时自愈：settings 段缺失就补一个
			if (ctx.get('wrtbwstat', 'settings') == null)
				ctx.add('wrtbwstat', 'settings');

			for (let kv in changed)
				ctx.set('wrtbwstat', 'settings', kv[0], kv[1]);

			ctx.commit('wrtbwstat');

			// 影响采集的项同步到 nlbwmon；nlbwmon 未安装时跳过同步
			let restart = false;
			let hasCollector = false;

			// 目录未变化时不重启采集进程，避免丢掉尚未落盘的内存数据
			let old_dir = uci_get('nlbwmon', '@nlbwmon[0]', 'database_directory');

			try {
				hasCollector = (cursor().get('nlbwmon', '@nlbwmon[0]') != null);
			}
			catch (e) {
				hasCollector = false;
			}

			if (hasCollector) {
				ctx.load('nlbwmon');

				for (let kv in changed) {
					switch (kv[0]) {
					case 'storage_dir':
						// nlbwmon 只写 storage_dir 下的 wrtbwstat/ 子目录
						ctx.set('nlbwmon', '@nlbwmon[0]', 'database_directory', data_dir_of(kv[1]));
						if (old_dir != data_dir_of(kv[1]))
							restart = true;
						break;
					case 'retention_days':
						ctx.set('nlbwmon', '@nlbwmon[0]', 'database_generations', kv[1]);
						break;
					case 'commit_interval':
						ctx.set('nlbwmon', '@nlbwmon[0]', 'commit_interval', kv[1]);
						break;
					case 'compress':
						ctx.set('nlbwmon', '@nlbwmon[0]', 'database_compress', kv[1]);
						break;
					}
				}

				ctx.commit('nlbwmon');
			}

			if (restart) {
				// 换目录时把旧库搬过去，用户不会因为改路径丢历史
				let new_dir = uci_get('nlbwmon', '@nlbwmon[0]', 'database_directory');

				run('/etc/init.d/nlbwmon stop >/dev/null 2>&1');
				try {
					move_db_files(old_dir, new_dir);
				}
				catch (e) {}
				run('/etc/init.d/nlbwmon start >/dev/null 2>&1');
				cache_clear();
			}

			return { success: true, changed: names, settings: read_settings() };
		}
		catch (e) {
			return { success: false, errors: [ { code: 'errWrite', detail: '' + e } ] };
		}
	}
};

methods.reset_database = {
	args: { confirm: false },
	call: function(request) {
		if (request.args?.confirm !== true)
			return { success: false, message: { code: 'errConfirm' } };

		let dir = collector_info().directory;

		if (type(dir) != 'string' || length(dir) < 5 || dir == '/')
			return { success: false, message: { code: 'errDirUnavailable' } };

		// 只清插件自己的数据目录（<storage_dir>/wrtbwstat），不碰别人的文件
		let slash = rindex(dir, '/');

		if ((slash >= 0 ? substr(dir, slash + 1) : dir) != DATA_SUBDIR)
			return { success: false, message: { code: 'errDirUnavailable' } };

		run('/etc/init.d/nlbwmon stop >/dev/null 2>&1');

		let removed = 0, failed = 0, freed = 0;

		/*
		 * nlbwmon 的库文件是按账期命名的 <YYYYMMDD>.db[.gz]（-Z 时压缩），
		 * 老版本才叫 nlbwmon.db；只匹配 nlbwmon.db* 会一个都删不到，
		 * 于是“清空成功但数据还在”。这里三种后缀都收。
		 */
		for (let pattern in [ dir + '/*.db', dir + '/*.db.gz', dir + '/nlbwmon.db*' ]) {
			for (let file in glob(pattern)) {
				let st = stat(file);
				if (st?.type != 'file')
					continue;
				try {
					if (unlink(file)) {
						removed++;
						freed += num(st?.size);
					}
				}
				catch (e) {
					failed++;
				}
			}
		}

		run('/etc/init.d/nlbwmon start >/dev/null 2>&1');
		cache_clear();

		return {
			success: (failed == 0),
			directory: dir,
			removed,
			failed,
			freed_bytes: freed
		};
	}
};

/*
 * 一键处置 fullcone 冲突。
 *
 * 两条底线：
 *   1. 不重启——动用户正在使用的路由器是侵扰性操作，页面只提示手动重启；
 *   2. 改文件前先备份到 /etc/wrtbwstat/backup/<时间戳>/ 并生成 restore.sh，
 *      备份不完整就整体放弃，不留下"改了一半、又退不回去"的状态。
 */
methods.fix_fullcone = {
	args: { confirm: false },
	call: function(request) {
		if (request.args?.confirm !== true)
			return { success: false, message: { code: 'errFixConfirm' } };

		let state = fullcone_state();
		let failed = [];

		// 没有可改的 .ko 却已经加载：模块编译进了内核，插件无能为力
		if (state.loaded && length(state.active) == 0 && length(state.disabled) == 0)
			return { success: false, message: { code: 'errFullconeBuiltin' }, changed: [] };

		// 先算清楚确实要改什么：已经关过的项不再重复写，也就不用多留一份备份
		let fw_needed = false;

		try {
			let ctx = cursor();
			ctx.load('firewall');

			if (ctx.get('firewall', '@defaults[0]') != null) {
				let v = ctx.get('firewall', '@defaults[0]', 'fullcone');
				let v6 = ctx.get('firewall', '@defaults[0]', 'fullcone6');

				fw_needed = (v != null && '' + v != '0') || (v6 != null && '' + v6 != '0');
			}
		}
		catch (e) {}

		let targets = [];

		if (state.modules_d)
			push(targets, '/etc/modules.d/nft-fullcone');

		for (let f in state.active)
			push(targets, f);

		if (!fw_needed && length(targets) == 0)
			return { success: true, changed: [], failed: [], reboot_required: state.loaded, backup_dir: null };

		// ---- 备份 ----
		// 同一秒内重复执行（连点）时不能覆盖上一份备份，加序号区分
		let stamp = backup_stamp();
		let dir = sprintf('%s/%s', BACKUP_ROOT, stamp);

		for (let i = 1; access(dir); i++)
			dir = sprintf('%s/%s-%d', BACKUP_ROOT, stamp, i);

		mkdir_p(dir);

		let backups = [];

		if (fw_needed) {
			if (copy_file('/etc/config/firewall', dir + '/firewall'))
				push(backups, [ '/etc/config/firewall', dir + '/firewall' ]);
			else
				push(failed, '/etc/config/firewall');
		}

		for (let src in targets) {
			let slash = rindex(src, '/');
			let dst = dir + '/' + (slash >= 0 ? substr(src, slash + 1) : src);

			if (copy_file(src, dst))
				push(backups, [ src, dst ]);
			else
				push(failed, src);
		}

		if (length(failed) > 0)
			return { success: false, message: { code: 'errBackupFailed', dir }, changed: [], failed };

		let script = '#!/bin/sh\n';
		script += '# FlowLens: 恢复 fullcone 修复前的文件；执行后请手动重启路由器。\n';
		script += 'set -e\n';

		for (let pair in backups) {
			script += sprintf('cp -a %s %s\n', shq(pair[1]), shq(pair[0]));
			script += sprintf('rm -f %s\n', shq(pair[0] + '.disabled'));
		}

		script += 'echo "FlowLens: restored, reboot the router manually to apply."\n';

		try {
			writefile(dir + '/restore.sh', script);
			run(sprintf('chmod 755 %s', shq(dir + '/restore.sh')));
			writefile(BACKUP_MARKER, dir + '\n');
		}
		catch (e) {
			return { success: false, message: { code: 'errBackupFailed', dir }, changed: [], failed };
		}

		// ---- 应用 ----
		let changed = [];

		if (fw_needed) {
			try {
				let ctx = cursor();
				ctx.load('firewall');
				ctx.set('firewall', '@defaults[0]', 'fullcone', '0');

				// fullcone6 在旧版 fw4 里不存在，只改已经有的选项
				if (ctx.get('firewall', '@defaults[0]', 'fullcone6') != null)
					ctx.set('firewall', '@defaults[0]', 'fullcone6', '0');

				ctx.commit('firewall');
				push(changed, 'firewall.fullcone');
			}
			catch (e) {
				push(failed, 'firewall: ' + e);
			}
		}

		for (let src in targets) {
			let r = disable_file(src);

			if (r == 'renamed') push(changed, src);
			else if (r == 'failed') push(failed, src);
		}

		let after = fullcone_state();

		return {
			success: (length(failed) == 0),
			changed,
			failed,
			reboot_required: after.loaded,
			backup_dir: dir
		};
	}
};

return { 'luci.wrtbwstat': methods };
