	return [];
}

// 读取指定日期的 nlbwmon 账期库：nlbw -c json -n -t YYYY-MM-DD
// 不直接解析数据库文件，避免绑定内部格式。
function read_day(date) {
	// TODO(M1)：fs.popen('nlbw -c json -n -t <date>') 并用 json() 解析。
	return [];
}

// 把 nlbwmon 的 MAC/IP/协议记录聚合成设备粒度（同 MAC 的多个 IPv6 合并）。
function aggregate(days, filters) {
	// TODO(M1)：按 MAC 归并 rx/tx，计算 share、first_seen、last_seen。
	return [];
}

// 设备名三级回退：自定义别名 -> DHCP 租约 hostname -> MAC
function resolve_hostname(mac) {
	// TODO(M1)：先读 /etc/config/wrtbwstat 的 alias 段，再读 /tmp/dhcp.leases。
	return mac;
}

// ---------------------------------------------------------------------------
// 方法实现
// ---------------------------------------------------------------------------

const methods = {};

methods.get_summary = {
	args: { range: '' },
	call: function(request) {
		const range = normalize_range(request.args?.range);
		return {
			range: range,
			updated: Math.floor(Date.now() / 1000),
			// 五个时间窗的汇总；前端总览卡片与趋势条消费该字段
			ranges: RANGES.map(function(r) {
				return {
					range: r,
					days: RANGE_DAYS[r],
					rx_bytes: 0,
					tx_bytes: 0,
					total_bytes: 0,
					series: []
				};
			})
		};
	}
};

methods.get_devices = {
	args: { range: '', sort: '', keyword: '' },
	call: function(request) {
		const range = normalize_range(request.args?.range);
		const sort = normalize_sort(request.args?.sort);
		const keyword = request.args?.keyword ?? '';

		return {
			range: range,
			sort: sort,
			keyword: keyword,
			total_bytes: 0,
			devices: []
		};
	}
};

methods.get_device = {
	args: { mac: '', range: '' },
	call: function(request) {
		const mac = (request.args?.mac ?? '').toLowerCase();
		const range = normalize_range(request.args?.range);

		return {
			mac: mac,
			hostname: resolve_hostname(mac),
			range: range,
			days: [],
			protocols: []
		};
	}
};

methods.get_settings = {
	args: {},
	call: function() {
		return read_settings();
	}
};

methods.set_settings = {
	args: { storage_dir: '', retention_days: 0, refresh_interval: 0 },
	call: function(request) {
		// TODO(M1)：校验 storage_dir 不在 tmpfs、retention_days >= 90，
		// 写入 /etc/config/wrtbwstat 后 commit，并重新生成 nlbwmon 基线。
		return { success: false, message: 'not implemented (M1)' };
	}
};

methods.reset_database = {
	args: { confirm: false },
	call: function(request) {
		// 危险操作：必须显式 confirm=true，仅供设置页二次确认后调用。
		if (request.args?.confirm !== true)
			return { success: false, message: 'confirmation required' };

		// TODO(M1)：停止 nlbwmon -> 删除 database_directory 下账期库 -> 重启。
		return { success: false, message: 'not implemented (M1)' };
	}
};

return { 'luci.wrtbwstat': methods };
