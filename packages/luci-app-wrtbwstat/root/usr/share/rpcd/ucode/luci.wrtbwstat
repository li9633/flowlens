// luci.wrtbwstat —— FlowLens 后端 ubus 对象
//
// 目标固件：OpenWrt 25.12+（rpcd-mod-ucode + ucode 环境）
// 依据：doc/OpenWrt流量统计插件设计文档_v2.md 第 5.1、4.4 节
//
// 当前状态：M1 骨架。接口签名与返回结构已按契约固定，
// 数据聚合逻辑（读取 nlbwmon 日账期库、MAC 归并、别名回退）待实现。
'use strict';

const fs = require('fs');
const uci = require('uci');

const RANGES = [ 'today', 'yesterday', 'last7', 'last30', 'last90' ];
const RANGE_DAYS = { today: 1, yesterday: 1, last7: 7, last30: 30, last90: 90 };
const DEFAULT_RETENTION_DAYS = 95;
const DEFAULT_REFRESH_INTERVAL = 30;

// ---------------------------------------------------------------------------
// 配置读取
// ---------------------------------------------------------------------------

function uci_get(config, section, option) {
	try {
		const ctx = uci.cursor();
		const value = ctx.get(config, section, option);
		return (value == null) ? null : value;
	}
	catch (e) {
		return null;
	}
}

function read_settings() {
	return {
		storage_dir: uci_get('wrtbwstat', 'settings', 'storage_dir') ?? '/mnt/usb/nlbwmon',
		retention_days: +(uci_get('wrtbwstat', 'settings', 'retention_days') ?? DEFAULT_RETENTION_DAYS),
		refresh_interval: +(uci_get('wrtbwstat', 'settings', 'refresh_interval') ?? DEFAULT_REFRESH_INTERVAL),
		collector_dir: uci_get('nlbwmon', '@nlbwmon[0]', 'database_directory') ?? null,
		collector_interval: uci_get('nlbwmon', '@nlbwmon[0]', 'database_interval') ?? null,
		local_networks: []
	};
}

function normalize_range(range) {
	return (range in RANGE_DAYS) ? range : 'today';
}

function normalize_sort(sort) {
	const allowed = [ 'total', 'rx', 'tx', 'hostname', 'mac' ];
	return (allowed.indexOf(sort) >= 0) ? sort : 'total';
}

// ---------------------------------------------------------------------------
// 数据聚合（TODO(M1)）
// ---------------------------------------------------------------------------

// 按时间窗枚举自然日，返回 [ 'YYYY-MM-DD', ... ]，以路由器本地时区为准。
