#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# 80_wrtbwstat —— 首次安装时把 nlbwmon 调整为 FlowLens 要求的采集基线。
# 幂等：已配置过的项不会重复写入；用户手工改过的 database_directory 会保留提示。
#
# 依据：doc/OpenWrt流量统计插件设计文档_v2.md 第 4.3 节

[ -f /lib/functions.sh ] && . /lib/functions.sh

STORAGE_DIR="$(uci -q get wrtbwstat.settings.storage_dir)"
RETENTION_DAYS="$(uci -q get wrtbwstat.settings.retention_days)"
COMMIT_INTERVAL="$(uci -q get wrtbwstat.settings.commit_interval)"
COMPRESS="$(uci -q get wrtbwstat.settings.compress)"

[ -n "$STORAGE_DIR" ]    || STORAGE_DIR="/mnt/usb"
[ -n "$RETENTION_DAYS" ] || RETENTION_DAYS="95"
[ -n "$COMMIT_INTERVAL" ] || COMMIT_INTERVAL="6h"
[ -n "$COMPRESS" ]       || COMPRESS="1"

# 旧版把 storage_dir 直接当作数据库目录（默认以 /nlbwmon 结尾）。
# 升级时把它收敛为父目录，避免出现 <旧目录>/wrtbwstat 的嵌套布局。
case "${STORAGE_DIR%/}" in
	*/nlbwmon)
		STORAGE_DIR="${STORAGE_DIR%/}"
		STORAGE_DIR="${STORAGE_DIR%/nlbwmon}"
		STORAGE_DIR="${STORAGE_DIR%/}"
		[ -n "$STORAGE_DIR" ] || STORAGE_DIR="/"
		uci -q set wrtbwstat.settings.storage_dir="$STORAGE_DIR"
		uci -q commit wrtbwstat
		;;
esac

# 实际数据目录固定为 <storage_dir>/wrtbwstat：目录里只有插件自己的库文件，
# 清空数据库时按目录处理也不会误删用户的其它数据。
DATA_DIR="${STORAGE_DIR%/}/wrtbwstat"

# --- nlbwmon 日账期基线 -----------------------------------------------------
uci -q batch <<-EOF
	set nlbwmon.@nlbwmon[0].database_interval='2026-01-01/1'
	set nlbwmon.@nlbwmon[0].database_generations='${RETENTION_DAYS}'
	set nlbwmon.@nlbwmon[0].commit_interval='${COMMIT_INTERVAL}'
	set nlbwmon.@nlbwmon[0].database_compress='${COMPRESS}'
	commit nlbwmon
EOF

# netlink 接收缓冲：默认 512KB 在连接数上千后会让 conntrack dump 溢出，
# 采集器一旦丢事件就会永久停摆。只在未设置或更小时抬到 4MB，不覆盖更大的自定义值。
NLBW_BUFFER="$(uci -q get nlbwmon.@nlbwmon[0].netlink_buffer_size)"
case "$NLBW_BUFFER" in
	''|*[!0-9]*) NLBW_BUFFER=0 ;;
esac
if [ "$NLBW_BUFFER" -lt 4194304 ]; then
	uci -q set nlbwmon.@nlbwmon[0].netlink_buffer_size='4194304'
	uci -q commit nlbwmon
fi

# SO_RCVBUF 会被内核翻倍后与 rmem_max 取小，rmem_max 至少容纳 2 倍目标值。
RMEM_MAX="$(cat /proc/sys/net/core/rmem_max 2>/dev/null || echo 0)"
case "$RMEM_MAX" in
	''|*[!0-9]*) RMEM_MAX=0 ;;
esac
if [ "$RMEM_MAX" -lt 16777216 ]; then
	sysctl -w net.core.rmem_max=16777216 >/dev/null 2>&1
fi

# nlbwmon 的库固定落在 DATA_DIR；换目录时先把旧库搬过去（不覆盖同名文件）
mkdir -p "$DATA_DIR" 2>/dev/null

CURRENT_DIR="$(uci -q get nlbwmon.@nlbwmon[0].database_directory)"
if [ "$CURRENT_DIR" != "$DATA_DIR" ]; then
	case "$CURRENT_DIR" in
		""|/tmp/*|/var/*)
			# 未配置或仍在 tmpfs：无需迁移
			;;
		*)
			# 先停采集进程，让它把当前账期落盘后再迁移，否则会漏掉当天库
			/etc/init.d/nlbwmon stop 2>/dev/null
			for f in "$CURRENT_DIR"/*.db "$CURRENT_DIR"/*.db.gz "$CURRENT_DIR"/nlbwmon.db*; do
				[ -f "$f" ] || continue
				[ -e "$DATA_DIR/$(basename "$f")" ] || mv "$f" "$DATA_DIR/" 2>/dev/null
			done
			;;
	esac
	uci -q set nlbwmon.@nlbwmon[0].database_directory="$DATA_DIR"
	uci -q commit nlbwmon
fi

# local_network 至少包含 lan；其他网段需用户在设置页补充。
case " $(uci -q get nlbwmon.@nlbwmon[0].local_network) " in
	*" lan "*) ;;
	*) uci -q add_list nlbwmon.@nlbwmon[0].local_network='lan'; uci -q commit nlbwmon ;;
esac

# --- 存储目录 ---------------------------------------------------------------
mkdir -p "$DATA_DIR" 2>/dev/null

# 数据目录若仍落在 tmpfs，页面会告警；此处不做强改，只记录日志。
case "$DATA_DIR" in
	/tmp/*|/var/*)
		logger -t wrtbwstat "WARNING: data directory '$DATA_DIR' is on tmpfs; history will be lost on reboot"
		;;
esac

# --- conntrack accounting ---------------------------------------------------
# 只对新建立的连接生效，需重启 nlbwmon / 等待连接重建。
if [ "$(cat /proc/sys/net/netfilter/nf_conntrack_acct 2>/dev/null)" != "1" ]; then
	sysctl -q -w net.netfilter.nf_conntrack_acct=1 2>/dev/null
fi

/etc/init.d/nlbwmon enable 2>/dev/null
/etc/init.d/nlbwmon restart 2>/dev/null

exit 0
