# 统一换行符：路由端脚本出现 CRLF 会直接执行失败
* text=auto eol=lf

*.sh            text eol=lf
80_*            text eol=lf
Makefile        text eol=lf
*.js            text eol=lf
*.vue           text eol=lf
*.json          text eol=lf
*.md            text eol=lf

# rpcd ucode 脚本与 view 必须保持 LF
packages/*/root/usr/share/rpcd/ucode/*  text eol=lf linguist-language=JavaScript

# 二进制产物
*.ipk  binary
*.apk  binary
*.png  binary
*.jpg  binary
